@inject HttpClient Http
@using PresentacionWildHaven.Pages

<div>
    <div class="input-group mb-3">
        <input type="number" class="form-control" placeholder="ID del reporte"
               @bind="ReporteId" />
        <button class="btn btn-primary" @onclick="BuscarReporte">Ver</button>
    </div>

    @if (MostrarModal)
    {
        <!-- Modal Bootstrap -->
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.4);" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Reporte #@ReporteId</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <DetalleReporte ReporteId="@ReporteId" />
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@code {
    private int ReporteId;
    private bool MostrarModal = false;

    private async Task BuscarReporte()
    {
        if (ReporteId <= 0) return;

        var resp = await Http.GetAsync($"api/Reportes/ReporteID/{ReporteId}");

        if (resp.IsSuccessStatusCode)
        {
            MostrarModal = true;
        }
        else
        {
            MostrarModal = false;
        }
    }

    private void CerrarModal()
    {
        MostrarModal = false;
    }
}
